# ── การเชื่อมต่อ SQL Server ──
# ใช้ทั้งฝั่ง API (/api/pos), สคริปต์สร้างตาราง และสคริปต์ย้ายข้อมูล
#
# ⚠️ ค่าด้านล่างเป็นตัวอย่าง ต้องแก้ให้ตรงกับเครื่องจริงก่อน ไม่งั้นจะต่อไม่ติด
# SQL_SERVER ใส่ได้ทั้ง IP, ชื่อเครื่อง, หรือชื่อเครื่อง\ชื่ออินสแตนซ์
#   ตัวอย่าง:  192.168.1.10   |   SRV-NARAI   |   SRV-NARAI\SQLEXPRESS   |   localhost
# ถ้าใส่ชื่ออินสแตนซ์ (แบบมี \) ไม่ต้องใส่ SQL_PORT — ปล่อยให้ SQL Browser หาพอร์ตเอง
SQL_SERVER=192.168.1.10
SQL_PORT=1433
SQL_DATABASE=SaneaPOS
SQL_USER=pos_app
# ⚠️ ถ้ารหัสผ่านมี # ต้องครอบด้วยเครื่องหมายคำพูด ไม่งั้นค่าจะถูกตัดตรงตัว # (ถือเป็นคอมเมนต์)
#    ผิด: SQL_PASSWORD=Abc#1234xyz     →  ได้ค่าแค่ "Abc" แล้วจะขึ้น Login failed
#    ถูก: SQL_PASSWORD="Abc#1234xyz"
SQL_PASSWORD="เปลี่ยนรหัสผ่านตรงนี้"

# เซิร์ฟเวอร์ในร้าน/ออฟฟิศส่วนใหญ่ไม่ได้เปิด TLS และใช้ใบรับรองของตัวเอง
SQL_ENCRYPT=false
SQL_TRUST_CERT=true

# ── ใช้เฉพาะตอนย้ายข้อมูลจาก Google Sheet ครั้งแรก ──
# URL /exec ของ Apps Script ตัวเดิม (ต้อง deploy เวอร์ชันที่มี action=exportSheet ก่อน)
GAS_EXPORT_URL=https://script.google.com/macros/s/AKfycbzxzhnOhSPWssbEfRVG8doa4G4fQ_98B9_Kog34gguPrG7fgbY5gPnuvTIoneJcmdKgrA/exec

# ── ตัวเลือกเพิ่มเติม ──
# ถ้ารัน API เป็นเซิร์ฟเวอร์ของตัวเอง (npm run api:serve)
API_PORT=8081
# โดเมนของรูปภาพ ถ้า API อยู่คนละที่กับหน้าเว็บ เช่น https://pos-api.example.com
# ไม่ตั้ง = ลิงก์รูปที่อัปโหลดใหม่จะชี้ผิดที่แล้วเปิดไม่ขึ้น
# IMAGE_BASE_URL=
# จำกัดโดเมนที่เบราว์เซอร์เรียก API ได้ (ไม่ใส่ = อนุญาตทุกโดเมน, คั่นหลายโดเมนด้วยจุลภาค)
# API_ALLOW_ORIGIN=https://pos.example.com
